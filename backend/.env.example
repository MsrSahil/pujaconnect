# Server Configuration
# Render automatically assigns PORT; in local dev defaults to 5000
PORT=5000
# Set to 'production' on Render
NODE_ENV=production

# Database (MongoDB Atlas)
# Example: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/pujaconnect?retryWrites=true&w=majority
MONGO_URI=

# Authentication (JWT)
# Use a long, secure random string (minimum 32 characters)
JWT_SECRET=
JWT_EXPIRE=7d

# Client / Frontend Origin (CORS)
# Set this to your deployed Vercel frontend URL in production (e.g. https://pujaconnect.vercel.app)
# Supports comma-separated origins if allowing both local and deployed URLs (e.g. http://localhost:5173,https://pujaconnect.vercel.app)
CLIENT_URL=http://localhost:5173
